# Copy this file to .env and fill in values before running.
# .env is gitignored and will never be committed.

# --- Database ---
# Used by Docker Compose to create the PostgreSQL database.
# Also used in DATABASE_URL below.
POSTGRES_DB=propfinder
POSTGRES_USER=propfinder
POSTGRES_PASSWORD=change-me-in-production

# --- Backend ---
# Secret key used to authenticate internal API calls.
API_KEY=change-me-in-production

# --- Frontend (baked into Next.js at build time) ---
# URL the browser uses to reach the backend API.
# For local dev: http://localhost:8000
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
